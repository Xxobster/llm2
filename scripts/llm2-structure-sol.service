[Unit]
Description=LLM2 structure_v1 SOLUSDT direction micro-live LIVE MIN_EXCHANGE
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/llm2-structure-sol
Environment=PYTHONPATH=/opt/llm2-structure-sol
Environment=LLM2_INDICATORS_DB=/opt/llm2-structure-sol/pack/indicators_live_slice.sqlite
Environment=TRADING_SECRETS_ENV=/root/.trading/secrets.env
ExecStart=/opt/llm2-structure-sol/venv/bin/python -m llm2.live.micro_runner --pack /opt/llm2-structure-sol/pack --state /opt/llm2-structure-sol/state/micro_live_state.sqlite --mode LIVE --live-orders --account Xxobster7 --cert /opt/llm2-structure-sol/certificate.yaml
Restart=always
RestartSec=10
StandardOutput=append:/opt/llm2-structure-sol/logs/micro_live.log
StandardError=append:/opt/llm2-structure-sol/logs/micro_live.log

[Install]
WantedBy=multi-user.target
